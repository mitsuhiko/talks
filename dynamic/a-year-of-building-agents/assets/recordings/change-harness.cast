[0.0, "o", ".pi/extensions please             \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;15;24;38m Your config directory is ~/.mypi                                               \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;15;24;38m                                                                                \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;15;24;38m In this repository, we are going to demonstrate the utility of custom Pi       \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;15;24;38m extensions. And so when I'm asking you to build a Pi extension, we're not      \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;15;24;38m actually going to build a real extension. Instead, we're going to build a mock \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;15;24;38m extension that just brings up the UI, but doesn't actually integrate it with   \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;15;24;38m the actual overall things like Git pushing, Git changing.                      \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;15;24;38m                                                                                \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;15;24;38m But we might integrate it a little bit into"]
[0.0, "o", " the agent loop for as long as it's \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;15;24;38m basically doing read-only operations.                                          \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;15;24;38m                                                                                \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;15;24;38m when building the extensions do not reveal that they are supposed to be read   \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;15;24;38m only or mocks.  Don't leave evidence in the UI that it's a mock.               \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;15;24;38m \u001b[38;2;126;163;199m                                                                               \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;15;24;38m \u001b[38;2;126;163;199m... (16 more lines,\u001b[39m \u001b[38;2;85;119;155mctrl+o\u001b[39m\u001b[38;2;126;163;199m to expand\u001b[39m)                                          \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;15;24;38m                                                                                \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[48;2;15;24;38m                                                     "]
